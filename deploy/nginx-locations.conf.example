# Integrate inside the existing ganwen.nl server block only after review.
# Keep TLS / ACME / original document root. Remove old PHP and WordPress
# rewrite includes; remove any existing conflicting location blocks first.
# Keep the HTTP->HTTPS redirect. Redirect bare ganwen.nl to www, retaining args.

location = /index.php {
    proxy_pass http://127.0.0.1:8097;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
}

# Blog media, including evidence, takes priority; old media remains a fallback.
location ~* \.(jpg|jpeg|png|gif|webp|avif|heic|heif|ico|mp4|m4v|mov|webm|mp3|m4a|ogg|wav|pdf)$ {
    proxy_pass http://127.0.0.1:8097;
    proxy_intercept_errors on;
    error_page 404 = @legacy_media;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
}

location @legacy_media {
    try_files $uri =404;
}

location ~ \.php(?:/|$) { return 404; }
location ~ /\. { deny all; }

location / {
    client_max_body_size 34m;
    proxy_pass http://127.0.0.1:8097;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_read_timeout 100s;
}
